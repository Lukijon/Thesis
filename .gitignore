# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# Data
data/raw/*
!data/raw/*/
!data/raw/*/.gitkeep

# CVM DFP: both the raw filing zip cache and the extracted notes
# PDFs/metadata stay local-only -- multi-GB, and re-fetchable from CVM any
# time via src/acquisition/. Previously the extracted PDFs were tracked via
# git-lfs and pushed to GitHub; that was reversed (history rewritten to
# strip them, see git log around the CLAUDE.md commit) because the LFS
# payload wasn't meant to go to the shared remote. They still live on disk
# locally (see CLAUDE.md), just outside git now.
data/raw/dfp/*
!data/raw/dfp/.gitkeep

# Bloomberg-derived market/analyst data: likely redistribution-restricted
# under Bloomberg's data license, so never commit regardless of size.
data/raw/market/*
!data/raw/market/.gitkeep
data/raw/analysts/*
!data/raw/analysts/.gitkeep

# Small manifest/log CSVs describing what was acquired are worth keeping;
# everything else in interim is regenerable from raw + code.
data/interim/*
!data/interim/.gitkeep
!data/interim/*.csv

# POC (small, and cited directly in reports/poc_note_extraction_findings.md)
!data/interim/poc/
data/interim/poc/*
!data/interim/poc/*.csv
!data/interim/poc/sections/

data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Reports / generated figures
reports/figures/**
!reports/figures/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
