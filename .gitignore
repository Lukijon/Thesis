# Local-only reference material -- advisor feedback, dissertation/exam
# guides, and guide papers. Personal/institutional communication and
# third-party copyrighted PDFs, not meant for the shared remote.
privado/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# LaTeX build artifacts -- tese_jonathan.pdf is kept (the actual deliverable), these regenerate from it
tese/latex/*.aux
tese/latex/*.log
tese/latex/*.out
tese/latex/*.toc
tese/latex/*.bbl
tese/latex/*.blg
tese/latex/compile_log_*.txt
tese/latex/bibtex_log.txt

# Environment / secrets
.env
.env.*
!.env.example

# Data
suporte/data/raw/*
!suporte/data/raw/*/
!suporte/data/raw/*/.gitkeep

# CVM DFP: both the raw filing zip cache and the extracted notes
# PDFs/metadata stay local-only -- multi-GB, and re-fetchable from CVM any
# time via suporte/src/acquisition/. Previously the extracted PDFs were tracked via
# git-lfs and pushed to GitHub; that was reversed (history rewritten to
# strip them, see git log around the CLAUDE.md commit) because the LFS
# payload wasn't meant to go to the shared remote. They still live on disk
# locally (see CLAUDE.md), just outside git now.
suporte/data/raw/dfp/*
!suporte/data/raw/dfp/.gitkeep

# ITR (quarterly) debt-note PDFs -- pilot for a quarterly-frequency textual
# similarity check, local-only like the annual DFP corpus above.
suporte/data/raw/itr/*
!suporte/data/raw/itr/.gitkeep

# Relatório da Administração (Management Report) PDFs -- same local-only
# treatment as the debt-note corpus above; re-fetchable from the already-
# cached filing zips any time via suporte/src/acquisition/cvm_management_report.py.
suporte/data/raw/dfp_mgmt_report/*
!suporte/data/raw/dfp_mgmt_report/.gitkeep

# Risk Factors (Formulario de Referencia item 4.1) PDFs -- same local-only
# treatment; re-fetchable any time via suporte/src/acquisition/cvm_fre.py.
suporte/data/raw/risk_factors/*
!suporte/data/raw/risk_factors/.gitkeep

# Bloomberg-derived market/analyst data: likely redistribution-restricted
# under Bloomberg's data license, so never commit regardless of size.
suporte/data/raw/market/*
!suporte/data/raw/market/.gitkeep
suporte/data/raw/analysts/*
!suporte/data/raw/analysts/.gitkeep

# Small manifest/log CSVs describing what was acquired are worth keeping;
# everything else in interim is regenerable from raw + code.
suporte/data/interim/*
!suporte/data/interim/.gitkeep
!suporte/data/interim/*.csv

# POC (small, and cited directly in exploracao/reports/poc_note_extraction_findings.md).
# lines_cache/ and bookmarks_cache/ are NOT excepted here deliberately --
# they're a large (1.6GB+), purely regenerable raw-PDF-parsing cache for
# iterating on the extraction heuristic (see suporte/src/processing/eval_note_locator.py),
# the same category as suporte/data/raw/dfp/_cache/ above: never commit regardless of size.
!suporte/data/interim/poc/
suporte/data/interim/poc/*
!suporte/data/interim/poc/*.csv
!suporte/data/interim/poc/sections/
!suporte/data/interim/poc/itr_sections/

# Reports / generated figures -- real chart deliverables are tracked
# (small PNGs); this still blocks anything else that lands here.
exploracao/reports/figures/**
!exploracao/reports/figures/.gitkeep
!exploracao/reports/figures/*.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
