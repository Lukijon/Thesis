# Data (never commit large/raw data or datasets pulled from paid sources)
data/raw/*
!data/raw/*/
!data/raw/*/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Reports / generated figures
reports/figures/**
!reports/figures/.gitkeep

