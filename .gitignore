# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# Data
data/raw/*
!data/raw/*/
!data/raw/*/.gitkeep

# CVM DFP: the raw filing zips are a re-derivable download cache (multi-GB,
# never worth backing up -- re-fetchable from CVM any time), so stay
# ignored. The extracted notes PDFs + metadata under data/raw/dfp/<CD_CVM>/
# are the actual acquisition output and are tracked via git-lfs (see
# .gitattributes) so they survive beyond this machine.
data/raw/dfp/_cache/

# Bloomberg-derived market/analyst data: likely redistribution-restricted
# under Bloomberg's data license, so never commit regardless of size.
data/raw/market/*
!data/raw/market/.gitkeep
data/raw/analysts/*
!data/raw/analysts/.gitkeep

# Small manifest/log CSVs describing what was acquired are worth keeping;
# everything else in interim is regenerable from raw + code.
data/interim/*
!data/interim/.gitkeep
!data/interim/*.csv

# POC (small, and cited directly in reports/poc_note_extraction_findings.md)
!data/interim/poc/
data/interim/poc/*
!data/interim/poc/*.csv
!data/interim/poc/sections/

data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Reports / generated figures
reports/figures/**
!reports/figures/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
